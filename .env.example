# Copier ce fichier en .env et changer les mots de passe.
# .env est ignoré par Git ; .env.example est commité (sans vrais secrets).

# --- MinIO (stockage objet compatible S3) ---
MINIO_ROOT_USER=jobmarket
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=jobmarket

# --- PostgreSQL (couche Gold) ---
POSTGRES_USER=jobmarket
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=jobmarket
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Spark ---
# 4 coeurs max : chaque coeur lance un worker Python (UDF) ; Docker n'a que 4 Go
SPARK_MASTER=local[4]
SPARK_DRIVER_MEMORY=1536m

# --- Collecte (API des ATS) ---
# Moyen de contact ajouté au User-Agent (adresse dédiée au projet conseillée)
COLLECTE_CONTACT=

# --- Alertes Telegram (voir scripts/configurer_telegram.py) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Airflow (jour 7) ---
# Fernet : python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
# JWT entre composants Airflow : python -c "import secrets;print(secrets.token_urlsafe(48))"
AIRFLOW_JWT_SECRET=
# Chemin ABSOLU du projet sur la machine hôte (monté dans les conteneurs de jobs)
JOBMARKET_HOST_DIR=
